---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatFullDate, withBase } from '../lib/content';

interface Props {
  entry: any;
  label: string;
  backHref: string;
  backLabel: string;
}

const { entry, label, backHref, backLabel } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL;
const rows = [
  ['Type', entry.data.type],
  ['Date', formatFullDate(entry.data.date)],
  ['Venue', entry.data.venue],
  ['Company', entry.data.company],
  ['Location', entry.data.location],
  ['Period', [entry.data.date_start, entry.data.date_end].filter(Boolean).join(' - ')],
].filter(([, value]) => value);
---

<BaseLayout title={entry.data.title ?? label}>
  <article class="content-page">
    <header class="detail-header">
      <a class="back-link" href={withBase(backHref, base)}>&larr; {backLabel}</a>
      <p class="eyebrow">{label}</p>
      <h1>{entry.data.title}</h1>
      {entry.data.excerpt && <p class="lead">{entry.data.excerpt}</p>}
      {rows.length > 0 && (
        <dl class="meta-grid">
          {rows.map(([name, value]) => (
            <div class="meta-row">
              <dt>{name}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
      )}
      <div class="entry-actions">
        {entry.data.paperurl && <a class="button" href={entry.data.paperurl}>Paper</a>}
        {entry.data.slidesurl && <a class="text-button" href={entry.data.slidesurl}>Slides</a>}
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
    {entry.data.citation && <p class="entry-citation" set:html={entry.data.citation} />}
  </article>
</BaseLayout>

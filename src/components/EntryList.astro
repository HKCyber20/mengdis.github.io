---
import { formatDate, getPermalink, withBase } from '../lib/content';

interface Props {
  entries: any[];
  fallbackRoot: string;
  showExcerpt?: boolean;
  showCitations?: boolean;
  compact?: boolean;
  numbered?: boolean;
}

const {
  entries,
  fallbackRoot,
  showExcerpt = true,
  showCitations = false,
  compact = false,
  numbered = true,
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<div class:list={['entry-list', compact && 'entry-list--compact']}>
  {entries.map((entry, index) => {
    const href = withBase(getPermalink(entry, fallbackRoot), base);
    const meta = [formatDate(entry.data.date), entry.data.type, entry.data.location].filter(Boolean).join(' · ');
    const venue = entry.data.venue ?? entry.data.company;

    return (
      <article class="entry-card">
        {numbered && <span class="entry-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>}
        <div class="entry-card__body">
          {meta && <p class="entry-meta">{meta}</p>}
          <h3><a href={href}>{entry.data.title}</a></h3>
          {venue && <p class="entry-venue">{venue}</p>}
          {showExcerpt && entry.data.excerpt && <p class="entry-excerpt">{entry.data.excerpt}</p>}
          {showCitations && entry.data.citation && <p class="entry-citation" set:html={entry.data.citation} />}
          <div class="entry-actions">
            <a class="inline-link" href={href}>Read details <span aria-hidden="true">→</span></a>
            {entry.data.paperurl && <a class="inline-link secondary" href={entry.data.paperurl} target="_blank" rel="noreferrer">Paper / Code <span aria-hidden="true">↗</span></a>}
            {entry.data.slidesurl && <a class="inline-link secondary" href={entry.data.slidesurl} target="_blank" rel="noreferrer">Slides <span aria-hidden="true">↗</span></a>}
          </div>
        </div>
      </article>
    );
  })}
</div>

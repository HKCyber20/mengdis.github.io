---
import ProfileSidebar from '../components/ProfileSidebar.astro';
import { navItems, site } from '../data/site';
import { withBase } from '../lib/content';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  activePath?: string;
}

const { title = site.title, description = site.description, activePath = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
const pageTitle = title === site.title ? title : `${title} | ${site.name}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="icon" href={withBase('/images/favicon.svg', base)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <a class="brand" href={withBase('/', base)} aria-label="Mengdi Shi home">
        Mengdi Shi
        <span>Academic Portfolio</span>
      </a>
      <nav class="nav" aria-label="Main navigation">
        {navItems.map((item) => (
          <a
            class:list={['nav-link', activePath === item.href && 'is-active']}
            href={withBase(item.href, base)}
          >
            {item.title}
          </a>
        ))}
      </nav>
    </header>

    <div class="page-shell">
      <ProfileSidebar />
      <main class="content" id="main">
        <slot />
      </main>
    </div>

    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} Mengdi Shi. Built with Astro.</p>
    </footer>
  </body>
</html>

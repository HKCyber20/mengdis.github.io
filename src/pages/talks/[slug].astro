---
import { getCollection } from 'astro:content';
import EntryDetail from '../../components/EntryDetail.astro';
import { getEntrySlug, isPublished } from '../../lib/content';

export async function getStaticPaths() {
  const talks = (await getCollection('talks')).filter(isPublished);
  return talks.map((entry) => ({
    params: { slug: getEntrySlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<EntryDetail entry={entry} label="Talk" backHref="/talks/" backLabel="Talks" />

---
import { getCollection } from 'astro:content';
import EntryList from '../../components/EntryList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortByDateDesc, withBase } from '../../lib/content';

const talks = sortByDateDesc(await getCollection('talks'));
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Talks and Presentations" activePath="/talks/">
  <section class="page-intro">
    <p class="eyebrow">Talks</p>
    <h1>Talks and Presentations</h1>
  </section>

  <section class="section-block">
    <EntryList entries={talks} fallbackRoot="talks" />
  </section>

  <section class="section-block">
    <h2>Talk Locations</h2>
    <iframe class="talk-map" src={withBase('/talkmap/map.html', base)} title="Talk locations map"></iframe>
  </section>
</BaseLayout>

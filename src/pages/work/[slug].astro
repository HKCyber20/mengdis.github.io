---
import { getCollection } from 'astro:content';
import EntryDetail from '../../components/EntryDetail.astro';
import { getEntrySlug, isPublished } from '../../lib/content';

export async function getStaticPaths() {
  const work = (await getCollection('work')).filter(isPublished);
  return work.map((entry) => ({
    params: { slug: getEntrySlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<EntryDetail entry={entry} label="Work Experience" backHref="/work-experience/" backLabel="Work Experience" />

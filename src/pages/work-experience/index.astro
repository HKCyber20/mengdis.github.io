---
import { getCollection } from 'astro:content';
import TimelineList from '../../components/TimelineList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isPublished, sortByDateDesc } from '../../lib/content';

const work = sortByDateDesc((await getCollection('work')).filter(isPublished));
---

<BaseLayout title="Research Experience" activePath="/work-experience/">
  <section class="page-intro">
    <div>
      <p class="eyebrow">Applied research</p>
      <h1>Experience</h1>
      <p class="lead">A track record of translating research ideas into reproducible models, evaluation systems, and scientific workflows.</p>
    </div>
    <aside class="page-intro__aside"><span>{String(work.length).padStart(2, '0')}</span><p>research and industry roles</p></aside>
  </section>
  <section class="timeline-section" aria-label="Work experience timeline">
    <TimelineList entries={work} fallbackRoot="work" variant="work" />
  </section>
</BaseLayout>

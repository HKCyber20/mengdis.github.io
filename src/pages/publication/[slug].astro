---
import { getCollection } from 'astro:content';
import EntryDetail from '../../components/EntryDetail.astro';
import { getEntrySlug } from '../../lib/content';

export async function getStaticPaths() {
  const publications = await getCollection('publications');
  return publications.map((entry) => ({
    params: { slug: getEntrySlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<EntryDetail entry={entry} label="Publication" backHref="/publications/" backLabel="Publications" />

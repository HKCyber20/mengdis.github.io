---
import { getCollection } from 'astro:content';
import EntryDetail from '../../components/EntryDetail.astro';
import { getEntrySlug, isPublished } from '../../lib/content';

export async function getStaticPaths() {
  const education = (await getCollection('education')).filter(isPublished);
  return education.map((entry) => ({
    params: { slug: getEntrySlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<EntryDetail entry={entry} label="Education" backHref="/education/" backLabel="Education" />
